# Production is always Access-authenticated. Never expose local mode via tunnel.
DASHBOARD_MODE=hosted
PORT=4317
DASHBOARD_ORIGIN=https://dashboard.YOUR_DOMAIN
CF_ACCESS_TEAM=https://YOUR_TEAM.cloudflareaccess.com
CF_ACCESS_AUD=YOUR_ACCESS_APPLICATION_AUDIENCE
DASHBOARD_OWNER=YOUR_EMAIL
# The immutable release identity: release.json inside the release directory (default), or an
# absolute path. Hosted mode refuses to start without a valid manifest. Generate it per release:
# {"version":"0.1.0","releaseId":"release-2026-01-01","schemaId":"pilot-state-1","createdAt":"2026-01-01T00:00:00.000Z"}
# DASHBOARD_RELEASE_MANIFEST=/home/USER/.local/share/pilot-releases/current/release.json
# Persistent data and approved roots are separate from application releases.
DASHBOARD_DATA=/home/USER/.local/share/pilot
DASHBOARD_ROOTS=/home/USER/projects
# Optional explicitly provided registry snapshot; no live Mac filesystem access.
# DASHBOARD_REGISTRY=/approved/path/projects.json
