# Owner-only Cloudflare Access pilot. Values are not secrets, but keep the file 0600.
# Create a separate Access application and tunnel route; never reuse the live
# dashboard's route or policy.
DASHBOARD_MODE=hosted
DASHBOARD_ORIGIN=https://pilot-dashboard.example.com
DASHBOARD_HEALTH_HOST=pilot-dashboard.example.com
DASHBOARD_BIND=0.0.0.0
CF_ACCESS_TEAM=https://<team>.cloudflareaccess.com
CF_ACCESS_AUD=<access application audience tag>
DASHBOARD_OWNER=owner@example.com
PORT=4319
DASHBOARD_DATA=/data
