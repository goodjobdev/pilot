# Loopback-only pilot (used to verify the container boundary before remote access).
# Reach it with an SSH tunnel: ssh -L 4319:127.0.0.1:4319 <host>
DASHBOARD_MODE=local
DASHBOARD_ORIGIN=http://127.0.0.1:4319
DASHBOARD_HEALTH_HOST=127.0.0.1:4319
# Inside its own network namespace the container must bind its interface for the
# published port to reach it. The host still publishes 127.0.0.1:4319 only.
DASHBOARD_BIND=0.0.0.0
PORT=4319
DASHBOARD_DATA=/data
