{
  "name": "pilot",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Self-hosted planning workspace: documentation is the source of work, and durable Pi agents work from it.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts tests/server/*.test.ts",
    "build": "vite build && esbuild src/server/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@xyflow/svelte": "^1.5.0",
    "dompurify": "^3.4.17",
    "jose": "^6.0.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "svelte": "^5.0.0",
    "typebox": "1.3.27",
    "web-push": "^3.6.7",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^22.0.0",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.25.0",
    "svelte-check": "^4.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
